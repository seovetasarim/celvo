# Yerel: copy .env.example .env.local  |  Vercel: Project → Settings → Environment Variables

# Canlı site adresi (SEO, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://celvo.com.tr

# MySQL (cPanel — uzak erişim + Remote MySQL’de izinli host)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306

# Uzak sunucuda genelde gerekir (Vercel → otomatik açılır; yerelde sorun olursa true yapın)
DB_SSL=true
